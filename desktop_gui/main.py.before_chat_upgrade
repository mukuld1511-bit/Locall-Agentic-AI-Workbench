        )

        badge_color = (
            "#178a55"
            if str(status).upper() == "COMPLETED"
            else "#c53b45"
        )

        safe_final = (
            str(final)
            .replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            .replace("\n", "<br>")
        )

        self.output.append(
            f"""
            <div style="
                margin:8px 90px 14px 6px;
                padding:14px;
                background:#ffffff;
                border:1px solid #dfe5ec;
                border-radius:12px;

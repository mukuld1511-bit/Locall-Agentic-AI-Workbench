                    margin-top:12px;
                    padding-top:10px;
                    border-top:1px solid #edf0f3;
                    color:#6d7885;
                    font-size:10px;
                ">
                    Steps: {completed}
                    &nbsp; · &nbsp;
                    Verification: {verification.get("overall_status","UNKNOWN")}
                </div>
            </div>
            """
        )

        if artifacts:
            self.output.append(
                f"""
                <div style="
                    margin:0 90px 14px 6px;
                    padding:12px 14px;
                    background:#eaf8f1;
                    border:1px solid #c9ead9;
                    border-radius:10px;
                    color:#178a55;
                ">
                    <b>Artifacts generated</b><br>
                    {"<br>".join(str(a) for a in artifacts)}

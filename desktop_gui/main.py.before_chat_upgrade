    def _run(self):
        task = self.task_input.toPlainText().strip()

        if not task:
            return

        user_text = task

        if self.attached_file:
            task += (
                f"\n\nAttached local file: {self.attached_file}"
            )

        # ----------------------------------------------------
        # User message
        # ----------------------------------------------------

        self.output.append(
            f"""
            <div style="
                margin:14px 6px 8px 90px;
                padding:12px 14px;
                background:#eaf2ff;
                border:1px solid #cfe0fb;
                border-radius:12px;
            ">
                <div style="color:#1769e0;font-size:10px;font-weight:700;">
                    YOU
                </div>
                <div style="margin-top:6px;color:#18212b;font-size:13px;">
                    {user_text.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace(chr(10),"<br>")}
                </div>
            </div>
            """
        )

        self.task_input.clear()
        self.run_button.setEnabled(False)
        self.status.setText("● THINKING")

        # ----------------------------------------------------
        # General direct response
        # ----------------------------------------------------

        user_id = self.user.get(
            "user_id",
            self.user.get("username", "usr_local"),
        )

        role = self.user.get(
            "role",
            "GRADE_2",
        )

        session_id = self.user.get(
            "session_id",
            f"gui_{uuid.uuid4().hex[:10]}",
        )

        if self.mode.currentText() == "General":

            try:
                result = MODEL_MGR.run_worker(
                    "general",
                    task,
                    request_id=session_id,
                    max_tokens=512,
                )

                content = getattr(
                    result,
                    "content",
                    "",
                )

                self.output.append(
                    f"""
                    <div style="
                        margin:8px 90px 14px 6px;
                        padding:12px 14px;
                        background:#ffffff;
                        border:1px solid #dfe5ec;
                        border-radius:12px;
                    ">
                        <div style="
                            color:#6d7885;
                            font-size:10px;
                            font-weight:700;
                        ">
                            LOCAL AI · GENERAL
                        </div>
                        <div style="
                            margin-top:7px;
                            color:#18212b;
                            font-size:13px;
                        ">
                            {str(content)
                                .replace("&","&amp;")
                                .replace("<","&lt;")
                                .replace(">","&gt;")
                                .replace(chr(10),"<br>")}
                        </div>
                    </div>
                    """
                )

            except Exception as exc:

                self.output.append(
                    f"""
                    <div style="
                        margin:8px 90px 14px 6px;
                        padding:12px 14px;
                        background:#fff0f1;
                        border:1px solid #f2c4c8;
                        border-radius:12px;
                    ">
                        <div style="color:#c53b45;font-weight:700;">
                            ERROR
                        </div>
                        <div style="margin-top:6px;">
                            {str(exc)}
                        </div>
                    </div>
                    """
                )

            self.run_button.setEnabled(True)
            self.status.setText("● LOCAL • READY")
            return

        # ----------------------------------------------------
        # Workflow
        # ----------------------------------------------------

        self.output.append(
            """
            <div style="
                margin:8px 90px 14px 6px;
                padding:10px 14px;
                background:#f8fafc;
                border:1px solid #dfe5ec;
                border-radius:10px;
            ">
                <span style="color:#1769e0;font-weight:700;">
                    LOCAL WORKFLOW
                </span>
                <span style="color:#6d7885;">
                    &nbsp; processing…
                </span>
            </div>
            """
        )

        self.thread = QThread()

        self.worker = WorkflowWorker(
            task,
            user_id,
            role,
            session_id,
        )

        self.worker.moveToThread(self.thread)

        self.thread.started.connect(
            self.worker.run
        )

        self.worker.finished.connect(
            self._workflow_done
        )

        self.worker.failed.connect(
            self._workflow_failed
        )

        self.worker.finished.connect(
            self.thread.quit
        )

        self.worker.failed.connect(
            self.thread.quit
        )

        self.thread.finished.connect(
            self._workflow_thread_finished
        )

        self.thread.start()


    def _workflow_thread_finished(self):
        self.run_button.setEnabled(True)

    def _workflow_failed(self, message):
        self.output.setPlainText(f"WORKFLOW FAILED\n\n{message}")
        self.status.setText("● LOCAL • ERROR")

